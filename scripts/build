#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
platform=$(go env GOOS)
version=${SCRYER_ENGINE_VERSION:-0.0.0-dev}
case "$version" in *[!0-9A-Za-z.-]*|'') exit 2 ;; esac
case "$platform" in
  darwin) library=libscryer-rust-engine.dylib ;;
  windows) library=scryer-rust-engine.dll ;;
  *) echo "Unsupported build platform: $platform" >&2; exit 1 ;;
esac
package=build/install/scryer-rust-engine
mkdir -p "$package/bin"
CGO_ENABLED=1 go build -trimpath -buildmode=c-shared -o "$package/bin/$library" ./cmd/rust-engine-abi
rm -f "$package/bin/${library%.*}.h"
cat > "$package/engine.json" <<MANIFEST
{
  "schemaVersion": 1,
  "engine": {
    "protocolVersion": 1,
    "id": "rust",
    "name": "Scryer Rust Engine",
    "version": "$version",
    "source": "github.com/scryer-labs/scryer-rust-engine",
    "mock": false
  },
  "capabilities": {
    "languages": ["Rust"],
    "operations": ["scan"],
    "resolveFacts": ["dependencies"],
    "scanFacts": ["dependencies", "architecture", "files", "ipc", "call-graph"]
  },
  "library": "bin/$library",
  "os": "$platform",
  "arch": "$(go env GOARCH)"
}
MANIFEST
cp LICENSE "$package/"
